---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('writing');
  return articles.map(article => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const levelLabel = { beginner: '入门', intermediate: '进阶', advanced: '高级' };
---
<BaseLayout title={article.data.title} description={article.data.summary}>
  <a href={`${import.meta.env.BASE_URL}writing`} style="color:#e94560; text-decoration:none;">← 返回文章列表</a>

  <article style="margin-top:1rem;">
    <header style="margin-bottom:2rem;">
      <h1>{article.data.title}</h1>
      <p style="color:#666; margin-top:0.5rem;">{article.data.summary}</p>
      <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.5rem;">
        <span style="background:#1a1a2e; color:white; padding:2px 8px; border-radius:4px; font-size:0.8rem;">
          {levelLabel[article.data.level]}
        </span>
        {article.data.tags.map(tag => (
          <span style="background:#f0f0f0; color:#666; padding:2px 8px; border-radius:4px; font-size:0.8rem;">
            {tag}
          </span>
        ))}
        <span style="color:#999; font-size:0.8rem;">
          更新于 {article.data.updatedAt}
        </span>
      </div>
    </header>

    <div class="writing-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .writing-content {
    background: #ffffff;
    color: #333333;
    padding: 2rem;
    border-radius: 8px;
    line-height: 1.8;
    color-scheme: light;
  }
  .writing-content :global(h1) {
    font-size: 1.8rem;
    color: #1a1a2e;
    margin-bottom: 1rem;
  }
  .writing-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid #f0f0f0;
    color: #1a1a2e;
    font-size: 1.4rem;
  }
  .writing-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #333;
    font-size: 1.2rem;
  }
  .writing-content :global(p) {
    margin-bottom: 1rem;
    color: #333;
  }
  .writing-content :global(ul), .writing-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    color: #333;
  }
  .writing-content :global(li) {
    margin-bottom: 0.3rem;
    color: #333;
  }
  .writing-content :global(blockquote) {
    border-left: 4px solid #e94560;
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    background: #f9f9f9;
    color: #555;
  }
  .writing-content :global(strong) {
    color: #1a1a2e;
  }
  .writing-content :global(code) {
    background: #f0f0f0;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.9em;
    color: #333;
  }
  .writing-content :global(a) {
    color: #e94560;
    text-decoration: none;
  }
  .writing-content :global(a:hover) {
    text-decoration: underline;
  }
</style>
